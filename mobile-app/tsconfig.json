{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "bundler",       
    "target": "ES2020",
    "strict": true,
    "skipLibCheck": true,
    "types": ["react", "react-native"],
    "customConditions": ["react-native"] 
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
